# ============================================================================
# VARIÁVEIS DE AMBIENTE — copie para .env (local) e cadastre na Vercel
# ----------------------------------------------------------------------------
# NENHUMA CHAVE ENTRA NO REPOSITÓRIO. Nem em config/, nem em src/, nem em
# comentário "só para testar". O .gitignore ignora .env — confira antes do
# primeiro commit com:  git status --porcelain | grep env
#
# Na Vercel:  Project > Settings > Environment Variables
# Depois de cadastrar, é preciso REDEPLOYAR: variável nova não entra em
# deployment que já existe.
# ============================================================================

# ---------------------------------------------------------------- GATEWAY
# Chaves da API de cobrança. Sem elas, /api/criar-pix responde 503 e a página
# cai no checkout hospedado (rede de segurança) em vez de morrer.
KORVEX_PUBLIC_KEY=
KORVEX_SECRET_KEY=

# Segredo que valida o webhook de pagamento. Sem ele, qualquer um consegue
# forjar um Purchase na sua conta de anúncios.
KORVEX_WEBHOOK_SECRET=

# Desliga a criação de Pix na própria página e força o checkout hospedado.
# Use quando a API do gateway estiver instável. Qualquer valor liga a trava.
KORVEX_PIX_DESLIGADO=

# ------------------------------------------------------------------- META
# Token da Conversions API. O ID do pixel fica no config (é público, aparece
# no HTML); o TOKEN é secreto e só existe aqui.
META_CAPI_TOKEN=
META_PIXEL_ID=

# Código da aba "Testar eventos" do Gerenciador. Deixe VAZIO em produção:
# com ele preenchido, os eventos reais não contam para as campanhas.
META_TEST_EVENT_CODE=

# ---------------------------------------------------------------- UTMIFY
# Token da API de pedidos da UTMify. Opcional: sem ele o webhook só não
# reporta a venda para lá.
UTMIFY_API_TOKEN=
